# Solo configuración no secreta. Compose genera secretos aleatorios persistentes.
API_PORT=3000
ADMIN_PORT=8080
RESERVATION_TTL_SECONDS=600
# En apps/mobile/.env: dirección de la máquina accesible desde el dispositivo.
# EXPO_PUBLIC_API_URL=http://IP_DE_TU_MAQUINA:3000/v1
# En desarrollo fuera de Docker, suministra DATABASE_URL / DATABASE_ADMIN_URL,
# JWT_SECRET, ISSUER_PRIVATE_KEY y DEMO_PASSWORD por el entorno, nunca por Git.
